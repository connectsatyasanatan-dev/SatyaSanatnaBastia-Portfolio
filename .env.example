#############################
# Database Configuration
#############################
POSTGRES_USER=myuser
POSTGRES_PASSWORD=StrongPassword123
POSTGRES_DB=portfolio_db

#############################
# Flask Backend Configuration
#############################
# Set to 'production' for cloud deployment
FLASK_ENV=production

# Core secret key for Flask sessions (Change this to a strong random string!)
SECRET_KEY=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_KEY

# The connection string for the backend to talk to the database container
DATABASE_URL=postgresql://myuser:StrongPassword123@db:5432/portfolio_db

# Secret key for JWT authentication (Change this to a long random string!)
JWT_SECRET_KEY=CHANGE_THIS_SECRET_KEY_FOR_PRODUCTION

#############################
# Cloudinary (Image Hosting)
#############################
CLOUDINARY_URL=cloudinary://YOUR_CLOUDINARY_URL_HERE

#############################
# Mail (Contact Form)
#############################
MAIL_USERNAME=example@gmail.com
MAIL_PASSWORD=your-app-password

#############################
# Next.js Frontend Configuration
#############################
# Used by Next.js server to fetch from the backend within the Docker network
BACKEND_URL=http://backend:5000

# Used by the browser (client-side) to fetch from the backend over the Internet
NEXT_PUBLIC_API_URL=http://localhost:5000

#############################
# AI Chatbot (Groq SDK)
#############################
# Optional: Get your free API key from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
