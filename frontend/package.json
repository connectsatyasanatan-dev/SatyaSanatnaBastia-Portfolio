{
    "name": "modern-portfolio-v2",
    "version": "1.0.0",
    "private": true,
    "description": "VS Code-inspired developer portfolio — Next.js frontend + Flask REST API backend",
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "next lint",
        "type-check": "tsc --noEmit",
        "backend:setup": "cd ../backend && python -m venv venv && .\\venv\\Scripts\\python -m pip install -r requirements.txt",
        "backend:dev": "cd ../backend && .\\venv\\Scripts\\python wsgi.py",
        "dev:all": "concurrently --kill-others-on-fail --names \"NEXT,FLASK\" --prefix-colors \"cyan,magenta\" \"npm run dev\" \"npm run backend:dev\""
    },
    "dependencies": {
        "@lottiefiles/dotlottie-react": "^0.18.9",
        "@tanstack/react-query": "^5.91.2",
        "@tanstack/react-query-devtools": "^5.91.3",
        "axios": "^1.13.6",
        "framer-motion": "^10.16.16",
        "lottie-react": "^2.4.1",
        "lucide-react": "^0.294.0",
        "next": "14.0.4",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "recharts": "^3.8.0"
    },
    "devDependencies": {
        "@types/node": "^20.10.5",
        "@types/react": "^18.2.45",
        "@types/react-dom": "^18.2.18",
        "@types/recharts": "^1.8.29",
        "concurrently": "^8.2.2",
        "eslint": "^8.56.0",
        "eslint-config-next": "14.0.4",
        "typescript": "^5.3.3"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}
